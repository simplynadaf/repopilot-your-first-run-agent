# RepoPilot config (optional). Copy to .env and adjust. The app works with defaults.

# AWS region where Amazon Bedrock (Nova Pro) is enabled.
AWS_REGION=us-east-1

# Bedrock model id for the reasoning step.
REPOPILOT_MODEL_ID=amazon.nova-pro-v1:0

# Optional: a GitHub token raises the API limit from 60 to 5000 requests/hour.
# RepoPilot works fine without it. Uncomment and paste a token to use it.
# GITHUB_TOKEN=ghp_your_token_here
